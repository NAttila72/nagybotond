  "motivation": {
    "quote": {
      "hu": "A fájdalom ideiglenes,<br>\n<span class=\"text-neon-blue neon-text\">a dicsőség örök.</span> 🔥",
      "en": "Pain is temporary,<br>\n<span class=\"text-neon-blue neon-text\">glory is forever.</span> 🔥",
      "de": "Der Schmerz ist vergänglich,<br>\n<span class=\"text-neon-blue neon-text\">der Ruhm ist ewig.</span> 🔥",
      "sl": "Bolečina je začasna,<br>\n<span class=\"text-neon-blue neon-text\">slava je večna.</span> 🔥"
    },
    "cards": [
      {
        "icon": "🏔️",
        "text": {
          "hu": "Minden emelkedő után egy lejtő jön. Csak tekerj tovább!",
          "en": "After every climb comes a descent. Just keep pedaling!",
          "de": "Nach jedem Anstieg kommt eine Abfahrt. Einfach weiterstrampeln!",
          "sl": "Za vsakim vzponom pride spust. Samo pelji naprej!"
        }
      },
      {
        "icon": "⚡",
        "text": {
          "hu": "A sebesség nem ajándék – a sebesség kemény munka eredménye.",
          "en": "Speed isn't a gift – speed is the result of hard work.",
          "de": "Geschwindigkeit ist kein Geschenk – Geschwindigkeit ist das Ergebnis harter Arbeit.",
          "sl": "Hitrost ni darilo – hitrost je rezultat trdega dela."
        }
      },
      {
        "icon": "🎯",
        "text": {
          "hu": "Az álmok nem teljesülnek maguktól. Minden nap edzés, minden nap egy lépés közelebb.",
          "en": "Dreams don't come true on their own. Every day of training is a step closer.",
          "de": "Träume erfüllen sich nicht von selbst. Jeder Trainingstag ist ein Schritt näher.",
          "sl": "Sanje se ne uresničijo same od sebe. Vsak dan treninga je korak bližje."
        }
      }
    ],
